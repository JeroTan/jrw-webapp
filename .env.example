# Copy this file to .env and replace every placeholder before running seed or auth flows.

# Seeded Super Admin credentials.
# Used by the Super Admin seed flow to create exactly one owner account.
SEED_SUPER_ADMIN_EMAIL="super-admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="replace-with-a-long-random-initial-password"
# Optional seed guardrails. Leave unset unless review explicitly approves.
# SEED_SUPER_ADMIN_TARGET_ENV="development"
# Destructive seed confirmations must be passed as CLI flags, not stored here.

# Dashboard authentication secrets.
# PASSWORD_PEPPER is mixed into password hashing and must be kept secret.
# JWT_SECRET signs/verifies auth-related JWTs when token helpers are used.
PASSWORD_PEPPER="replace-with-a-long-random-password-pepper"
JWT_SECRET="replace-with-a-long-random-jwt-secret"

# Google OAuth
GOOGLE_CLIENT_ID="example-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="example-google-client-secret"
# Optional. Fallback: APP_BASE_URL/PUBLIC_APP_BASE_URL + /api/oauth/google/callback.
GOOGLE_REDIRECT_URI="https://example.com/api/oauth/google/callback"

# Paymongo API keys
PAYMONGO_SECRET_KEY="sk_test_1234567890abcdef"
PAYMONGO_PUBLIC_KEY="pk_test_1234567890abcdef"

# Email
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="JRW <onboarding@resend.dev>"
# Optional safe provider result logs. Logs provider message id on success and sanitized provider error on failure.
RESEND_DEBUG="false"
# Optional canonical public URL override for verification links.
# Fallback order: APP_BASE_URL/PUBLIC_APP_BASE_URL, request URL origin, http://localhost:4321.
APP_BASE_URL="https://example.com"

