---
import { IconButton, SearchInput } from "@/components/ui";

const categoryLinks = [
  { href: "/categories/new-arrivals", label: "New arrivals" },
  { href: "/categories/everyday-essentials", label: "Everyday essentials" },
  { href: "/categories/home-office", label: "Home office" },
  { href: "/categories/travel", label: "Travel" },
];
---

<header class="jrw-storefront-header" role="banner">
  <div class="jrw-storefront-shell__inner jrw-storefront-header__mobile">
    <a
      aria-label="JRW lifestyle products home"
      class="jrw-storefront-logo"
      href="/"
    >
      JRW
    </a>

    <div class="jrw-storefront-header__mobile-actions">
      <form action="/cart" class="jrw-storefront-action-form" method="get">
        <div class="jrw-storefront-cart-action">
          <IconButton label="Open cart" type="submit">
            <svg
              aria-hidden="true"
              class="jrw-storefront-icon"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                d="M4 5H6L8 15H18L20 8H7.5"
                stroke="currentColor"
                stroke-width="1.5"
              ></path>
              <circle cx="10" cy="19" r="1.5" fill="currentColor"></circle>
              <circle cx="17" cy="19" r="1.5" fill="currentColor"></circle>
            </svg>
          </IconButton>
          <span aria-hidden="true" class="jrw-storefront-cart-count">0</span>
        </div>
      </form>

      <a aria-label="Sign in" class="jrw-storefront-account-link" href="/account">
        Sign in
      </a>

      <details class="jrw-storefront-mobile-menu">
        <summary class="jrw-storefront-mobile-menu__toggle">Menu</summary>

        <div class="jrw-storefront-mobile-menu__panel">
          <form action="/products" class="jrw-storefront-search" method="get" role="search">
            <SearchInput
              hideLabel
              id="storefront-mobile-search"
              label="Search products"
              name="q"
              placeholder="Search products"
            />
          </form>

          <nav aria-label="Categories" class="jrw-storefront-nav-shell">
            <ul class="jrw-storefront-nav jrw-storefront-nav--mobile">
              {
                categoryLinks.map((category) => (
                  <li>
                    <a class="jrw-storefront-nav__link" href={category.href}>
                      {category.label}
                    </a>
                  </li>
                ))
              }
              <li>
                <a class="jrw-storefront-nav__link" href="/products">
                  All products
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </details>
    </div>
  </div>

  <div class="jrw-storefront-shell__inner jrw-storefront-header__desktop">
    <a
      aria-label="JRW lifestyle products home"
      class="jrw-storefront-logo"
      href="/"
    >
      JRW
    </a>

    <nav aria-label="Categories" class="jrw-storefront-nav-shell">
      <ul class="jrw-storefront-nav">
        {
          categoryLinks.map((category) => (
            <li>
              <a class="jrw-storefront-nav__link" href={category.href}>
                {category.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="jrw-storefront-nav__link" href="/products">
            All products
          </a>
        </li>
      </ul>
    </nav>

    <form action="/products" class="jrw-storefront-search" method="get" role="search">
      <SearchInput
        hideLabel
        id="storefront-desktop-search"
        label="Search products"
        name="q"
        placeholder="Search products"
      />
    </form>

    <div class="jrw-storefront-header__desktop-actions">
      <form action="/cart" class="jrw-storefront-action-form" method="get">
        <div class="jrw-storefront-cart-action">
          <IconButton label="Open cart" type="submit">
            <svg
              aria-hidden="true"
              class="jrw-storefront-icon"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                d="M4 5H6L8 15H18L20 8H7.5"
                stroke="currentColor"
                stroke-width="1.5"
              ></path>
              <circle cx="10" cy="19" r="1.5" fill="currentColor"></circle>
              <circle cx="17" cy="19" r="1.5" fill="currentColor"></circle>
            </svg>
          </IconButton>
          <span aria-hidden="true" class="jrw-storefront-cart-count">0</span>
        </div>
      </form>

      <a aria-label="Sign in" class="jrw-storefront-account-link" href="/account">
        Sign in
      </a>
    </div>
  </div>
</header>
