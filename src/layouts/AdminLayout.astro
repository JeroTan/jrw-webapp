---
import { DashboardShell, type DashboardRole } from "@/components/layout";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  activeHref: string;
  description: string;
  role?: DashboardRole;
  title: string;
}

const {
  activeHref,
  description,
  role,
  title,
} = Astro.props;
const adminActor = Astro.locals.adminActor;
const resolvedRole = role ?? adminActor?.role ?? "ADMIN";
const resolvedUserLabel =
  resolvedRole === "SUPER_ADMIN" ? "Super Admin" : "Admin";
---

<BaseLayout description={description} robots="noindex,nofollow" title={title}>
  <DashboardShell
    activeHref={activeHref}
    brandScopeLabel="All brands"
    client:load
    role={resolvedRole}
    userLabel={resolvedUserLabel}
  >
    <slot />
  </DashboardShell>
</BaseLayout>
