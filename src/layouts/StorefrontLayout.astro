---
import {
  StorefrontFooter,
  StorefrontHeader,
} from "@/features/storefront-shell";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CUSTOMER_SESSION_COOKIE_NAME } from "@/server/auth/session-cookie";

interface Props {
  canonicalUrl?: string;
  title?: string;
  description?: string;
  mainAriaLabel?: string;
  robots?: string;
  socialImageAlt?: string;
  socialImageUrl?: string;
  class?: string;
}

const {
  canonicalUrl,
  title = "JRW — Lifestyle Products",
  description = "Browse JRW. lifestyle products.",
  mainAriaLabel = "Storefront content",
  robots,
  socialImageAlt,
  socialImageUrl,
  class: className,
} = Astro.props;

const initialAccountState = Astro.cookies.get(CUSTOMER_SESSION_COOKIE_NAME)?.value
  ? "authenticated"
  : "public";
---

<BaseLayout
  canonicalUrl={canonicalUrl}
  description={description}
  robots={robots}
  socialImageAlt={socialImageAlt}
  socialImageUrl={socialImageUrl}
  title={title}
>
  <a
    class="absolute left-grid-sm top-grid-xs z-61 inline-flex min-h-control-md translate-y-[-160%] items-center border border-brand-border-strong bg-brand-surface px-grid-xs font-system text-xs font-bold no-underline focus-visible:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
    href="#main-content"
  >
    Skip to main content
  </a>

  <StorefrontHeader
    client:load
    currentUrl={`${Astro.url.pathname}${Astro.url.search}`}
    initialAccountState={initialAccountState}
  />

  <main
    aria-label={mainAriaLabel}
    class={`mx-auto w-[min(100%,1440px)] 3xl:px-grid-lg xs:px-grid-md px-grid-sm p-grid-sm ${className || ""}`}
    id="main-content"
    role="main"
  >
    <slot />
  </main>

  <StorefrontFooter />
</BaseLayout>
