---
import {
  StorefrontFooter,
  StorefrontHeader,
} from "@/features/storefront-shell";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  canonicalUrl?: string;
  title?: string;
  description?: string;
  mainAriaLabel?: string;
  robots?: string;
  socialImageAlt?: string;
  socialImageUrl?: string;
}

const {
  canonicalUrl,
  title = "JRW — Lifestyle Products",
  description = "Browse JRW. lifestyle products.",
  mainAriaLabel = "Storefront content",
  robots,
  socialImageAlt,
  socialImageUrl,
} = Astro.props;
---

<BaseLayout
  canonicalUrl={canonicalUrl}
  description={description}
  robots={robots}
  socialImageAlt={socialImageAlt}
  socialImageUrl={socialImageUrl}
  title={title}
>
  <a
    class="absolute left-grid-sm top-grid-xs z-61 inline-flex min-h-control-md translate-y-[-160%] items-center border border-brand-border-strong bg-brand-surface px-grid-xs font-system text-xs font-bold no-underline focus-visible:translate-y-0"
    href="#main-content"
  >
    Skip to main content
  </a>

  <StorefrontHeader />

  <main
    aria-label={mainAriaLabel}
    class="mx-auto w-[min(100%,1440px)] p-grid-sm xs:p-grid-md lg:py-grid-lg 3xl:px-grid-lg"
    id="main-content"
    role="main"
  >
    <slot />
  </main>

  <StorefrontFooter />
</BaseLayout>
