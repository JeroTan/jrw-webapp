---
import { StorefrontPlaceholder } from "@/features/storefront-shell";
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";
---

<StorefrontLayout
  title="Account | JRW"
  description="Sign in or create account to continue checkout."
  mainAriaLabel="Account placeholder"
>
  <StorefrontPlaceholder
    copy="Browse JRW now, then return here when you need sign-in or account details."
    kicker="Account"
    links={[
      { href: "/", label: "Back to storefront home" },
      { href: "/products", label: "Browse products" },
    ]}
    title="Account access opens here"
    titleId="account-placeholder-title"
  />
</StorefrontLayout>
