---
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";
---

<StorefrontLayout
  title="Account | JRW"
  description="Sign in or create account to continue checkout."
  mainAriaLabel="Account placeholder"
>
  <section class="jrw-storefront-placeholder" aria-labelledby="account-placeholder-title">
    <p class="jrw-storefront-kicker">Account</p>
    <h1 class="jrw-storefront-placeholder__title" id="account-placeholder-title">
      Account access opens here
    </h1>
    <p class="jrw-storefront-placeholder__copy">
      Browse JRW now, then return here when you need sign-in or account details.
    </p>
    <div class="jrw-storefront-inline-links">
      <a class="jrw-storefront-link" href="/">
        Back to storefront home
      </a>
      <a class="jrw-storefront-link" href="/products">
        Browse products
      </a>
    </div>
  </section>
</StorefrontLayout>
