---
import { CustomerRegisterPanel } from "@/features/customer-account";
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";

const returnTo = Astro.url.searchParams.get("returnTo") ?? undefined;
---

<StorefrontLayout
  title="Create account | JRW"
  description="Create a JRW customer account for profile reuse and future order history."
  mainAriaLabel="Customer registration"
>
  <CustomerRegisterPanel client:load returnTo={returnTo} />
</StorefrontLayout>
