---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { BrandDetail } from "@/features/brands/components/BrandDetail";

const brandId = Astro.params.id ?? "";
---

<AdminLayout
  activeHref="/admin/brands"
  title="Brand Detail | JRW Admin"
  description="Manage brand members, invites, join requests, and products."
>
  <BrandDetail brandId={brandId} client:load />
</AdminLayout>
