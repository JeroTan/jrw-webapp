---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminSignInPanel } from "@/features/admin-auth";
---

<BaseLayout
  title="Sign In | JRW Admin"
  description="Sign in to JRW admin."
  robots="noindex,nofollow"
>
  <main class="grid min-h-screen place-items-center bg-brand-background p-grid-md">
    <div class="w-full max-w-[520px]">
      <AdminSignInPanel client:load />
    </div>
  </main>
</BaseLayout>
