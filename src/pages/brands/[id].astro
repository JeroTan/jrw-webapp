---
import { fetchStorefrontBrandRow } from "@/features/storefront-brands/api";
import { StorefrontBrandDetail } from "@/features/storefront-brands";
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";

export const prerender = false;

const brandSlug = Astro.params.id ?? "";

if (brandSlug.length === 0) {
  return Astro.redirect("/brands");
}

const brand = await fetchStorefrontBrandRow(Astro.url, brandSlug);
---

<StorefrontLayout
  title="Brand Products | JRW"
  description="Browse JRW products from this brand."
  mainAriaLabel="Brand products"
>
  <StorefrontBrandDetail brand={brand} slug={brandSlug} />
</StorefrontLayout>
