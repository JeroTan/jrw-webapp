---
import { fetchStorefrontBrandRows } from "@/features/storefront-brands/api";
import { StorefrontBrandIndex } from "@/features/storefront-brands";
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";

export const prerender = false;

const query = Astro.url.searchParams.get("q") ?? "";
const withProductsOnly = Astro.url.searchParams.get("withProducts") === "1";
const brandRows = await fetchStorefrontBrandRows(Astro.url);
---

<StorefrontLayout
  title="Brands | JRW"
  description="Browse JRW products grouped by brand."
  mainAriaLabel="Brand browsing"
>
  <StorefrontBrandIndex
    query={query}
    rows={brandRows}
    withProductsOnly={withProductsOnly}
  />
</StorefrontLayout>
