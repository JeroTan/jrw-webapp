---
import { StorefrontPlaceholder } from "@/features/storefront-shell";
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";

const slug = Astro.params.slug ?? "category";
const categoryName = slug
  .split("-")
  .filter(Boolean)
  .map((segment) => `${segment.charAt(0).toUpperCase()}${segment.slice(1)}`)
  .join(" ");

const resolvedCategoryName = categoryName || "Category";
---

<StorefrontLayout
  title={`${resolvedCategoryName} | JRW Categories`}
  description={`Browse ${resolvedCategoryName} products from JRW.`}
  mainAriaLabel="Category placeholder"
>
  <StorefrontPlaceholder
    copy="Products in this category are being prepared. Browse all products or return home."
    kicker="Category"
    links={[
      { href: "/products", label: "Browse all products" },
      { href: "/", label: "Return home" },
    ]}
    title={resolvedCategoryName}
    titleId="category-placeholder-title"
  />
</StorefrontLayout>
