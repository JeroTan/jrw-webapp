---
import { PaymentReturnStatus } from "@/features/cart-checkout";
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";

const attemptId = Astro.url.searchParams.get("attemptId");
const paymentId = Astro.url.searchParams.get("paymentId");
const providerCheckoutSessionId = Astro.url.searchParams.get(
  "providerCheckoutSessionId"
);
---

<StorefrontLayout
  title="Checkout Receipt | JRW"
  description="Check JRW checkout receipt and payment status."
  mainAriaLabel="Checkout receipt"
>
  <PaymentReturnStatus
    attemptId={attemptId}
    paymentId={paymentId}
    providerCheckoutSessionId={providerCheckoutSessionId}
    client:load
  />
</StorefrontLayout>
