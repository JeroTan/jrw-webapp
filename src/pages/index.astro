---
import {
  ProductCatalogPage,
  fetchStorefrontCatalogPageData,
} from "@/features/product-catalog";
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";

export const prerender = false;

const pageData = await fetchStorefrontCatalogPageData({
  baseUrl: Astro.url,
});
---

<StorefrontLayout
  title="JRW — Lifestyle Products"
  description="Browse JRW. lifestyle products."
  mainAriaLabel="JRW. storefront home"
>
  <ProductCatalogPage
    basePath="/"
    catalog={pageData.catalog}
    categories={pageData.categories}
    categoryNavigationMode="route"
    error={pageData.error}
    mode="home"
    query={pageData.query}
    showCategoryDirectory
    view={pageData.view}
  />
</StorefrontLayout>
