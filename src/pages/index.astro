---
import ProductCatalog from "@/features/product-catalog/ProductCatalog";
import StorefrontHomeHero from "@/features/storefront-shell/StorefrontHomeHero";
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";
import { loadStorefrontCatalogPageData } from "@/server/loaders/PublicCatalogPageDataLoader";
import { env } from "cloudflare:workers";

export const prerender = false;

const pageData = await loadStorefrontCatalogPageData({
  baseUrl: Astro.url,
  runtimeEnv: env as Partial<Env> & Record<string, unknown>,
});
---

<StorefrontLayout
  title="JRW — Lifestyle Products"
  description="Browse JRW. lifestyle products."
  mainAriaLabel="JRW. storefront home"
>
  <StorefrontHomeHero />
  <ProductCatalog
    basePath="/"
    brands={pageData.brands}
    catalog={pageData.catalog}
    categories={pageData.categories}
    categoryNavigationMode="route"
    error={pageData.error}
    query={pageData.query}
    showFilters={false}
    view={pageData.view}
  />
</StorefrontLayout>
