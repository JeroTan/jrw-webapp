---
import {
  ProductDetailErrorState,
  ProductDetailPage,
} from "@/features/product-detail";
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";
import { loadStorefrontProductDetailPageData } from "@/server/loaders/PublicCatalogPageDataLoader";
import { env } from "cloudflare:workers";

export const prerender = false;

const slug = (Astro.params.slug ?? "").trim();

if (slug.length === 0) {
  return Astro.redirect("/products");
}

const pageData = await loadStorefrontProductDetailPageData({
  runtimeEnv: env as Partial<Env> & Record<string, unknown>,
  slug,
});

Astro.response.status = pageData.status;
const metadata = pageData.detail?.metadata ?? null;
const title = metadata?.title ?? `${pageData.error?.title ?? "Product unavailable"} | JRW`;
const description =
  metadata?.description ??
  pageData.error?.message ??
  "Product page is unavailable right now. Try again soon.";
const canonicalUrl = metadata
  ? new URL(metadata.canonicalPath, Astro.url).toString()
  : Astro.url.toString();
const socialImageUrl = metadata?.imageSrc
  ? new URL(metadata.imageSrc, Astro.url).toString()
  : undefined;
---

<StorefrontLayout
  canonicalUrl={canonicalUrl}
  description={description}
  mainAriaLabel="Product detail"
  robots={metadata?.robots ?? "noindex,nofollow"}
  socialImageAlt={metadata?.imageAlt}
  socialImageUrl={socialImageUrl}
  title={title}
>
  {pageData.detail ? (
    <ProductDetailPage client:load detail={pageData.detail} />
  ) : pageData.error ? (
    <ProductDetailErrorState error={pageData.error} />
  ) : (
    <ProductDetailErrorState
      error={{
        code: "PROVIDER_UNAVAILABLE",
        message: "Product page is unavailable right now. Try again soon.",
        title: "Product unavailable",
      }}
    />
  )}
</StorefrontLayout>
