---
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";
---

<StorefrontLayout
  title="Products | JRW"
  description="Browse JRW lifestyle products."
  mainAriaLabel="Products placeholder"
>
  <section class="jrw-storefront-placeholder" aria-labelledby="products-placeholder-title">
    <p class="jrw-storefront-kicker">Products</p>
    <h1 class="jrw-storefront-placeholder__title" id="products-placeholder-title">
      Product grid ships in Story 4.2
    </h1>
    <p class="jrw-storefront-placeholder__copy">
      This surface holds public product browsing, category filtering, and search
      results next.
    </p>
    <a class="jrw-storefront-link" href="/">
      Back to storefront home
    </a>
  </section>
</StorefrontLayout>
