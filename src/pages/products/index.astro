---
import { StorefrontPlaceholder } from "@/features/storefront-shell";
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";
---

<StorefrontLayout
  title="Products | JRW"
  description="Browse JRW. lifestyle products."
  mainAriaLabel="Products placeholder"
>
  <StorefrontPlaceholder
    copy="JRW products are being prepared for browsing. Use category links or return to the storefront home."
    kicker="Products"
    links={[{ href: "/", label: "Back to storefront home" }]}
    title="Product list coming soon"
    titleId="products-placeholder-title"
  />
</StorefrontLayout>
